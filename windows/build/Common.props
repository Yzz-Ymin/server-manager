<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <NoStdLib>true</NoStdLib>
    <ReferenceAssemblyDirectory Condition="Exists('$(MSBuildThisFileDirectory)..\artifacts\reference-assemblies\package\build\.NETFramework\v4.8\mscorlib.dll')">$(MSBuildThisFileDirectory)..\artifacts\reference-assemblies\package\build\.NETFramework\v4.8</ReferenceAssemblyDirectory>
    <ReferenceAssemblyDirectory Condition="'$(ReferenceAssemblyDirectory)' == ''">$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8</ReferenceAssemblyDirectory>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\bin\$(Configuration)\</OutputPath>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppConfig>$(MSBuildThisFileDirectory)App.config</AppConfig>
    <WarningLevel>4</WarningLevel>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <DebugSymbols Condition="'$(Configuration)' == 'Debug'">true</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Debug'">full</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <TargetFrameworkRootPath Condition="Exists('$(MSBuildThisFileDirectory)..\artifacts\reference-assemblies\package\build\.NETFramework\v4.8\mscorlib.dll')">$(MSBuildThisFileDirectory)..\artifacts\reference-assemblies\package\build\</TargetFrameworkRootPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(ReferenceAssemblyDirectory)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Compile Include="$(MSBuildThisFileDirectory)AssemblyInfo.cs"><Link>Properties\AssemblyInfo.cs</Link></Compile>
  </ItemGroup>
</Project>
